# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_replace_me

# Stripe (publishable key only — secret key never goes in the app)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Daily.co (video) — domain only; room URLs are minted server-side
EXPO_PUBLIC_DAILY_DOMAIN=your-team.daily.co

# PostHog analytics (optional — the app runs fine without it; events are
# simply not sent). Project API key is the public phc_... value from
# PostHog → Settings → Project → Project API key.
EXPO_PUBLIC_POSTHOG_API_KEY=phc_replace_me
# US cloud default; use https://eu.i.posthog.com for an EU project.
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
